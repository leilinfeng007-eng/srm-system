# Copy to .env for local Compose only. Replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=srm-stage0
SRM_GATEWAY_PORT=8088
SRM_BACKEND_PORT=8080

SRM_DB_NAME=srm
SRM_DB_USERNAME=srm_app
SRM_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
SRM_DB_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD

# At least 48 characters. Production must be supplied by its secret manager.
SRM_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_48_RANDOM_CHARACTERS_1234567890
SRM_BOOTSTRAP_ADMIN_USERNAME=admin
SRM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_2026
SRM_BOOTSTRAP_VIEWER_USERNAME=skeleton_viewer
SRM_BOOTSTRAP_VIEWER_PASSWORD=CHANGE_ME_VIEWER_PASSWORD_2026
SRM_CORS_ALLOWED_ORIGINS=http://localhost:8088
SRM_LOG_LEVEL=INFO
SRM_OPENAPI_ENABLED=true
