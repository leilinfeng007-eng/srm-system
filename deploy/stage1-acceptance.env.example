# Copy this file to deploy/.env.stage1-acceptance on the isolated acceptance host.
# Fill every blank secret there and chmod 600. Never commit the populated file.
# The fixed names below deliberately cannot overlap the production project or volumes.

COMPOSE_PROJECT_NAME=srm-stage1-acceptance
SRM_GATEWAY_PORT=18088
SRM_MYSQL_VOLUME_NAME=srm-stage1-acceptance-mysql-data
SRM_ATTACHMENT_VOLUME_NAME=srm-stage1-acceptance-attachments

# Exactly three SRM application images share one immutable candidate tag.
# MySQL 8.4 and Nginx 1.27-alpine remain fixed official images in the Compose file.
SRM_BACKEND_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-backend
SRM_INTERNAL_WEB_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-internal-web
SRM_SUPPLIER_WEB_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-supplier-web
SRM_IMAGE_TAG=

SRM_DB_NAME=srm_stage1_acceptance
SRM_DB_USERNAME=srm_stage1_acceptance
SRM_DB_PASSWORD=
SRM_DB_ROOT_PASSWORD=

SRM_JWT_SECRET=
SRM_BOOTSTRAP_ADMIN_USERNAME=stage1_acceptance_admin
SRM_BOOTSTRAP_ADMIN_PASSWORD=
SRM_BOOTSTRAP_VIEWER_USERNAME=stage1_acceptance_viewer
SRM_BOOTSTRAP_VIEWER_PASSWORD=
SRM_CORS_ALLOWED_ORIGINS=https://srm-stage1-acceptance.invalid
SRM_LOG_LEVEL=INFO
