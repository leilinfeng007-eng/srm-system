# Copy to deploy/.env.prod on the production host and fill every blank value.
# This example is intentionally unusable: Compose rejects missing values and the containers
# reject short or placeholder secrets. Never commit deploy/.env.prod.

COMPOSE_PROJECT_NAME=srm-production
SRM_GATEWAY_PORT=8088
SRM_MYSQL_VOLUME_NAME=srm-production-mysql-data
SRM_ATTACHMENT_VOLUME_NAME=srm-production-attachments

# TCR repositories and one immutable tag shared by all three application images.
SRM_BACKEND_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-backend
SRM_INTERNAL_WEB_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-internal-web
SRM_SUPPLIER_WEB_IMAGE=ccr.ccs.tencentyun.com/leizi114/srm-supplier-web
SRM_IMAGE_TAG=

SRM_DB_NAME=
SRM_DB_USERNAME=
SRM_DB_PASSWORD=
SRM_DB_ROOT_PASSWORD=

SRM_JWT_SECRET=
SRM_BOOTSTRAP_ADMIN_USERNAME=
SRM_BOOTSTRAP_ADMIN_PASSWORD=
SRM_BOOTSTRAP_VIEWER_USERNAME=
SRM_BOOTSTRAP_VIEWER_PASSWORD=
SRM_CORS_ALLOWED_ORIGINS=
SRM_LOG_LEVEL=INFO
